# Copia este archivo como .env (en local) y rellénalo con tu connection string de Neon.
# La encuentras en el panel de Neon: Dashboard > Connect > Connection string.
# En Vercel, esta misma variable se configura en Project Settings > Environment Variables,
# NUNCA subas el archivo .env real a git (ya está listado en .gitignore).
DATABASE_URL=postgres://usuario:password@ep-xxxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
